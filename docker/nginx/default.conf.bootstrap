server {
    listen 80;
    listen [::]:80;
    server_name itoro.f5.si;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
        allow all;
    }

    location / {
        return 200 'ok';
        add_header Content-Type text/plain;
    }
}
